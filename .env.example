# This file is documentation only — do NOT put real values here.
#
# Config lives at ~/.config/unifi-cli/config (chmod 600, never committed).
#
# Setup:
#   mkdir -p ~/.config/unifi-cli && chmod 700 ~/.config/unifi-cli
#   cp .env.example ~/.config/unifi-cli/config
#   chmod 600 ~/.config/unifi-cli/config
#   # then edit ~/.config/unifi-cli/config with real values

UNIFI_HOST=192.168.1.1
UNIFI_API_KEY=your_network_api_key_here   # UniFi Network → Settings → Control Plane → Integrations
UNIFI_SITE_NAME=default                   # site name (default for single-site installs)
UNIFI_SITE_ID=                            # optional — auto-discovered if blank
